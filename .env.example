# Copy to .env.local and fill in. .env.local is gitignored.

# --- Database ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/myworldcity?retryWrites=true&w=majority

# --- Auth / Session ---
# 32+ char random string. Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# --- SMS provider (Phone OTP) ---
# Leave blank in development to log OTPs to the server console instead of sending SMS.
SMS_PROVIDER=                 # "msg91" | "twilio" | "" (dev/console)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Image uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Seed/admin bootstrap: phone numbers (10-digit) granted admin role on first login
ADMIN_PHONES=
# One-time secret to call POST /api/admin/seed via the x-seed-secret header (before any admin exists)
SEED_SECRET=
